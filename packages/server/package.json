{
  "name": "@tabvault/server",
  "version": "1.0.0",
  "description": "Signaling, WebSocket presence, MongoDB persistence, and S3 Presigned Relay for TabVault",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/lambda.cjs --external:@aws-sdk/*",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.637.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@tabvault/core": "*",
    "fastify": "^4.28.1",
    "mongoose": "^8.5.3",
    "nanoid": "^5.0.7",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.12",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.23.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
