{
  "name": "@tabvault/mobile",
  "version": "1.0.0",
  "description": "Cross-platform mobile app for iOS and Android with QR Pairing, Universal Clipboard, and Native Share Sheet",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:apk": "cd fastlane && bundle exec fastlane android build_apk"
  },
  "dependencies": {
    "@tabvault/core": "*",
    "expo": "~51.0.28",
    "expo-camera": "~15.0.14",
    "expo-clipboard": "~6.0.3",
    "expo-file-system": "~17.0.1",
    "expo-notifications": "~0.28.14",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "nanoid": "^5.0.7",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.5.4"
  },
  "private": true
}
